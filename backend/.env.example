# Copy to .env for local development. Real values never go into git.

# PostgreSQL. This default is the database from `docker compose up -d db` (host port 5433).
# On Neon use the DIRECT connection string (not the -pooler host) with ?sslmode=require.
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5433/clinic

# Origins the browser UI may call from, comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Reviewer aid: lets a request set "now" with the X-Test-Clock header. Keep false in real use.
TEST_CLOCK_ENABLED=true

LOG_LEVEL=INFO

# Seconds to wait for the database to accept a connection (Neon may need a few to wake up).
DB_CONNECT_TIMEOUT_S=10

# Tests use their own database on the same server, created on demand. Only set this to move it.
# TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5433/clinic_test

# Anchor date (YYYY-MM-DD, India time) for the seed scenarios. Defaults to today when unset.
# SEED_ANCHOR_DATE=2026-10-22

# Requests per minute allowed from one client address before 429. 0 switches the limit off.
# RATE_LIMIT_PER_MINUTE=600

# Database connections kept per process, and how many more a burst may borrow.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# How many reverse proxies append to X-Forwarded-For (the Render blueprint uses 1).
# TRUSTED_PROXY_HOPS=0

# Staff sign-in is REQUIRED by default: patient names and phones are not readable by anyone with
# the link. AUTH_SECRET (16+ characters) signs the sessions; BOOTSTRAP_ADMIN_* creates the first
# administrator when no account exists yet (or run
#   python -m scripts.create_staff --username dev --name "Dev Admin" --role ADMIN).
# STAFF_PASSWORD (8+ characters) is a single shared password, the simplest alternative.
# ALLOW_OPEN_ACCESS=true leaves the API open with no sign-in, for a local stack or a review demo
# only; never on a clinic's real data.
# AUTH_SECRET=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# STAFF_PASSWORD=
# ALLOW_OPEN_ACCESS=false
# AUTH_TOKEN_TTL_HOURS=12

# Where messages to patients are POSTed as JSON ({to, body, kind}); unset, they wait on the
# Messages page for reception. NOTIFY_WEBHOOK_TOKEN is sent as a Bearer token if set.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=

# Or send straight through a Twilio account (all three together). NOTIFY_CHANNEL is sms or
# whatsapp; for WhatsApp, TWILIO_FROM is the approved WhatsApp sender number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# NOTIFY_CHANNEL=sms

# Optional: GET /metrics then needs "Authorization: Bearer <token>".
# METRICS_TOKEN=

# Seconds between sweeps that pass lapsed waitlist offers on and send queued messages. 0 is off.
# OFFER_SWEEP_INTERVAL_S=30
