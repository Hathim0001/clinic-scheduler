# Settings read by `docker compose up --build` (copy to .env; real values never go into git).
# Everything is optional: with none set, the stack starts with the demo data and no sign-in.
# The full list of backend settings, with explanations, is backend/.env.example.

# Sign-in. The local stack is open by default; set ALLOW_OPEN_ACCESS=false to require it.
# ALLOW_OPEN_ACCESS=true
# AUTH_SECRET=                       # 16+ characters; signs sessions, turns on staff accounts
# BOOTSTRAP_ADMIN_USERNAME=          # the first administrator, created once if no account exists
# BOOTSTRAP_ADMIN_PASSWORD=          # 8+ characters
# STAFF_PASSWORD=                    # alternative: one shared password (8+ characters)

# Demo logins (reception, dr.rao, dr.menon) created with the seed, for local use only.
# SEED_DEMO_ACCOUNTS=true
# DEMO_ACCOUNTS_PASSWORD=

# Messages and reminders to patients: a Twilio account, or a webhook that receives {to, body, kind}.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# NOTIFY_CHANNEL=sms                 # sms or whatsapp
# NOTIFY_WEBHOOK_URL=

# Requests per minute from one client address before 429. 0 switches the limit off.
# RATE_LIMIT_PER_MINUTE=600
